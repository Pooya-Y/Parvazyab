NODE_ENV=development
PORT=4000
# Matches docker-compose.dev.yml (Postgres/Redis published on localhost).
DATABASE_URL=postgres://parvazyab:parvazyab@127.0.0.1:55432/parvazyab
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SEED_DEMO_DATA=true
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-12+-chars

# Integration tests (npm run test:int) truncate this database; its name must end with _test.
# TEST_DATABASE_URL=postgres://parvazyab:parvazyab@127.0.0.1:55432/parvazyab_test
