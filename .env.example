# Copy to .env and adjust before `docker compose up`.

# Required. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional overrides (defaults shown).
# POSTGRES_PASSWORD=parvazyab
# HTTP_PORT=8080
# CLIENT_ORIGIN=http://localhost:8080
# Set to true when served over HTTPS.
# COOKIE_SECURE=false
# Demo agencies, demo user and sample flights (idempotent).
# SEED_DEMO_DATA=true
# Creates an admin account on startup if it doesn't exist (password: 12+ chars).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
