# Copy to .env and adjust before `docker compose up`.

# Required. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional overrides (defaults shown).
# POSTGRES_PASSWORD=parvazyab
# HTTP_PORT=8080
# CLIENT_ORIGIN=http://localhost:8080
# Set to true when served over HTTPS.
# COOKIE_SECURE=false
# Demo agencies, demo user and sample flights (idempotent).
# SEED_DEMO_DATA=true
# Creates an admin account on startup if it doesn't exist (password: 12+ chars).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Email (verification, password reset). Links point at APP_URL.
# APP_URL=http://localhost:8080
# With the default console transport, production logs only record that a mail
# was due; nothing is delivered. To receive mail locally, start the bundled
# catcher (docker compose --profile mail up -d, inbox at http://localhost:8025) and set:
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtp://mailpit:1025
# MAIL_FROM=پروازیاب <no-reply@parvazyab.example>
